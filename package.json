{
  "name": "riftjack",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/run.mjs supervisor",
    "bootstrap:codex": "node scripts/run.mjs main --bootstrap-codex",
    "check:config": "node scripts/run.mjs main --check-config",
    "check:claude": "node scripts/run.mjs main --check-claude",
    "bootstrap:claude": "node scripts/run.mjs main --bootstrap-claude",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "bootstrap:grok": "node scripts/run.mjs main --bootstrap-grok",
    "test:http": "node --import tsx --test test/http/*.test.ts",
    "test:all": "npm test && npm run test:http",
    "start:executor": "node scripts/run.mjs executor-main"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.6.6",
    "@vector-im/matrix-bot-sdk": "0.10.1-element.0",
    "htmlparser2": "12.0.0",
    "marked": "18.0.14",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "2.16.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
