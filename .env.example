# Template only: keep actual server addresses and credentials in the instance .env.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_OWNER_ID=
# Synapse admin token for creating accounts. Keep this on the connector host.
SYNAPSE_ADMIN_TOKEN=
# Optional separate admin endpoint; loopback HTTP supports an SSH tunnel.
# SYNAPSE_ADMIN_URL=http://127.0.0.1:18008
# Optional automatic SSH tunnel. Requires key/ssh-agent login and a verified known_hosts entry.
# SYNAPSE_SSH_TARGET=user@your-server
# SYNAPSE_SSH_PORT=22
# SYNAPSE_SSH_REMOTE_PORT=8008
# SYNAPSE_SSH_IDENTITY=/absolute/path/to/private-key
# Alternative to an admin token: Synapse shared-secret registration.
# SYNAPSE_REGISTRATION_SHARED_SECRET=

# Default working directory for both engines.
RIFTJACK_WORKSPACE=/absolute/path/to/your/project
# Shared access mode; each engine applies its own sandbox and permission rules.
CODEX_SANDBOX=workspace-write
# Codex bots only: install Codex CLI separately and sign in with ChatGPT.
# CODEX_PATH may be an absolute executable path if codex is not on PATH.
# Pin settings for all Codex bots; blank values inherit Codex settings.
CODEX_MODEL=
# Model-supported effort, for example low, medium or high.
CODEX_REASONING_EFFORT=
# default = standard speed; priority = priority processing. Blank inherits.
CODEX_SERVICE_TIER=
CODEX_PATH=codex
# Route Codex approval requests to the encrypted Matrix conversation.
# Set never to deny command/file/permission escalations instead.
CODEX_APPROVAL_POLICY=on-request

# Claude bots only: install Claude Code and sign in with a Claude account.
# CLAUDE_PATH may be an absolute executable path if claude is not on PATH.
CLAUDE_PATH=claude
CLAUDE_MODEL=
# Route Claude Code permission requests to the encrypted Matrix conversation (workspace-write only).
# Set never to deny anything its sandbox and edit rules do not already allow.
CLAUDE_APPROVAL_POLICY=on-request

DATA_DIR=./data
# Total task time, including confirmation waits (default: 24 hours).
TASK_TIMEOUT_SECONDS=86400
# Maximum attachment size, both incoming and outgoing (default and maximum: 512 MiB).
MAX_MEDIA_BYTES=536870912
# Overall outgoing upload deadline, including streaming encryption (default: 30 minutes).
MEDIA_UPLOAD_TIMEOUT_SECONDS=1800

# Optional offline voice-message transcription through transcribe.cpp (disabled when model is blank).
# Install ffmpeg and transcribe-cli separately; reuse an existing GGUF model. No downloads at runtime.
# All paths must be absolute and outside agent workspaces.
# AUDIO_TRANSCRIBE_MODEL=/absolute/path/to/whisper-medium-Q8_0.gguf
# AUDIO_TRANSCRIBE_PATH=/absolute/path/to/transcribe-cli
# AUDIO_FFMPEG_PATH=/absolute/path/to/ffmpeg
# Maximum audio duration and total processing deadline; one file at a time across all bots.
# AUDIO_MAX_SECONDS=300
# AUDIO_TIMEOUT_SECONDS=120

# Optional read-only fetch tool for Codex and Claude bots, without approvals; not
# offered to read-only bots, because it saves response bodies into the workspace.
# GET/HEAD only, only under these HTTPS URL prefixes (each must end with "/";
# "https://*.example.com/" allows subdomains), and never to non-public addresses.
# Blank disables the tool.
# FETCH_ALLOW=https://api.github.com/repos/OWNER/REPO/ https://*.blob.core.windows.net/
# Bearer tokens attached only to URLs under their prefix: "prefix|/path/to/token-file".
# The token is not passed to the model, but an agent that can read the token file
# can still read it: keep the file outside agent-readable directories and prefer a
# read-only token.
# FETCH_AUTH=https://api.github.com/repos/OWNER/REPO/|/absolute/path/to/read-only-token
# Responses are saved under .fetch/ in the bot's workspace by a small Python 3 helper
# that never follows symlinks there. Python 3 is found on PATH, or set its absolute
# path here; it must be outside RIFTJACK_WORKSPACE.
# FETCH_PYTHON=/usr/bin/python3
# Largest saved response body in bytes (default 20 MiB).
# FETCH_MAX_BYTES=20971520

# Optional external Grok workers. Loopback only; reach it through SSH or an HTTPS proxy.
# 0 disables the listener. Set 8788 to enable.
WORKER_PORT=0
